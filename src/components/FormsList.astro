---
import { PortableText } from "astro-portabletext";
import { loadQuery } from '../../lib/load-query';

interface FormItem {
  title: string;
  description?: string;
  link: string;
  linkText?: string;
  formReference?: {
    _id: string;
    title?: string;
    description?: string;
    link?: string;
    linkText?: string;
  };
  pageReference?: {
    _id: string;
    title?: string;
    slug?: {
      current: string;
    };
    description?: string;
  };
}

interface Props {
  content: {
    title?: string;
    description?: string;
    forms?: FormItem[];
    autoIncludeForms?: boolean;
  };
}

const { content } = Astro.props;

// Fetch forms from Sanity if autoIncludeForms is enabled
let allForms: Array<{
  id: string;
  title: string;
  description: string;
  link: string;
  linkText: string;
}> = [];

if (content.autoIncludeForms !== false) {
  // Fetch all forms from Sanity
  const { data: forms } = await loadQuery({
    query: `*[_type == "form"]{_id, title, description, link, linkText} | order(title asc)`,
    params: {},
    enabled: true
  });

  // Fetch all form pages from Sanity
  const { data: formPages } = await loadQuery({
    query: `*[_type == "page" && slug.current match "forms/*"]{_id, title, slug, description} | order(title asc)`,
    params: {},
    enabled: true
  });

  // Combine forms and form pages
  allForms = [
    ...(forms || []).map((form: any) => ({
      id: form._id,
      title: form.title,
      description: form.description || '',
      link: form.link || '#',
      linkText: form.linkText || 'View Form'
    })),
    ...(formPages || []).map((page: any) => ({
      id: page._id,
      title: page.title,
      description: page.description || '',
      link: `/${page.slug?.current || ''}`,
      linkText: 'View Form'
    }))
  ];
}

// Add manually added forms from content
if (content.forms && Array.isArray(content.forms)) {
  for (const formItem of content.forms) {
    // If form has a reference, resolve it
    if (formItem.formReference?._id) {
      const formRef = formItem.formReference;
      allForms.push({
        id: formRef._id,
        title: formRef.title || formItem.title,
        description: formRef.description || formItem.description || '',
        link: formRef.link || formItem.link || '#',
        linkText: formRef.linkText || formItem.linkText || 'View Form'
      });
    } else if (formItem.pageReference?._id) {
      const pageRef = formItem.pageReference;
      allForms.push({
        id: pageRef._id,
        title: pageRef.title || formItem.title,
        description: pageRef.description || formItem.description || '',
        link: `/${pageRef.slug?.current || ''}`,
        linkText: formItem.linkText || 'View Form'
      });
    } else {
      // Use manual form data
      allForms.push({
        id: formItem.title.toLowerCase().replace(/\s+/g, '-'),
        title: formItem.title,
        description: formItem.description || '',
        link: formItem.link || '#',
        linkText: formItem.linkText || 'View Form'
      });
    }
  }
}

// Remove duplicates and sort alphabetically
const uniqueForms = Array.from(
  new Map(allForms.map(form => [form.id, form])).values()
).sort((a, b) => a.title.localeCompare(b.title));

// Split into two columns
const leftColumn = uniqueForms.filter((_, index) => index % 2 === 0);
const rightColumn = uniqueForms.filter((_, index) => index % 2 === 1);
---

<section class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      {content.title && (
        <h1 class="text-5xl font-bold text-center mb-4 font-source-serif-4 animate-on-scroll slide-up">
          {content.title}
        </h1>
      )}
      {content.description && (
        <p class="text-xl text-center mb-12 text-gray-600 font-source-serif-4 animate-on-scroll slide-up delay-100">
          {content.description}
        </p>
      )}
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Left Column -->
        <div class="space-y-6">
          {leftColumn.map((form) => (
            <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow animate-on-scroll slide-up">
              <h3 class="text-2xl font-bold mb-2 font-source-serif-4 text-black">
                {form.title}
              </h3>
              {form.description && (
                <p class="text-gray-600 mb-4 font-source-serif-4">
                  {form.description}
                </p>
              )}
              <a 
                href={form.link} 
                class="inline-block px-6 py-2 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition-colors font-source-code-pro uppercase tracking-wide"
              >
                {form.linkText}
              </a>
            </div>
          ))}
        </div>
        
        <!-- Right Column -->
        <div class="space-y-6">
          {rightColumn.map((form) => (
            <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow animate-on-scroll slide-up">
              <h3 class="text-2xl font-bold mb-2 font-source-serif-4 text-black">
                {form.title}
              </h3>
              {form.description && (
                <p class="text-gray-600 mb-4 font-source-serif-4">
                  {form.description}
                </p>
              )}
              <a 
                href={form.link} 
                class="inline-block px-6 py-2 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition-colors font-source-code-pro uppercase tracking-wide"
              >
                {form.linkText}
              </a>
            </div>
          ))}
        </div>
      </div>
      
      {uniqueForms.length === 0 && (
        <div class="text-center py-12">
          <p class="text-gray-500 text-lg">No forms available at this time.</p>
        </div>
      )}
    </div>
  </div>
</section>

